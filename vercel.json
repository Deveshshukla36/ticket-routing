{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "CONFIDENCE_THRESHOLD": "0.60",
    "DEFAULT_MODEL_VARIANT": "A",
    "LLM_PROVIDER": "offline"
  }
}