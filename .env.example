# Server Configuration
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite default, or PostgreSQL)
# SQLite: sqlite:///tickets.db
# PostgreSQL: postgresql://user:password@localhost:5432/ticket_routing
DATABASE_URL=sqlite:///tickets.db

# ML & Smart Routing Configuration
DEFAULT_MODEL_VARIANT=A
CONFIDENCE_THRESHOLD=0.60

# Optional AI Enhancement (RAG / LLM Suggestions)
# If left empty, system operates offline using built-in semantic retrieval & templates
LLM_PROVIDER=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
