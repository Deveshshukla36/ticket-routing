# Server Configuration
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database: SQLite locally; Neon Postgres (pooled connection string) on Render
# Local:      sqlite:///./tickets.db
# Production: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=sqlite:///./tickets.db

# ML & Smart Routing Configuration
DEFAULT_MODEL_VARIANT=A
CONFIDENCE_THRESHOLD=0.60

# Optional AI Enhancement (RAG / LLM Suggestions)
# If left empty, system operates offline using built-in semantic retrieval & templates
LLM_PROVIDER=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model backend: sklearn (default, local .joblib) | roberta (Hugging Face hosted, sklearn fallback)
MODEL_BACKEND=sklearn
# Read-scoped HF token. Set in Render / GitHub secrets — never commit a real value.
HF_API_TOKEN=
# Hub repo of the fine-tuned model, e.g. your-org/roberta-intent-8class
HF_MODEL_ID=
# Optional: dedicated Inference Endpoint URL (overrides the serverless router)
HF_ENDPOINT_URL=

# --- Frontend (Next.js) ---
# Render backend URL used by the browser. Leave unset locally (dev proxy -> :8000).
# NEXT_PUBLIC_API_BASE=https://intentroute-api.onrender.com
